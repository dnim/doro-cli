{
  "name": "doro-cli",
  "version": "1.5.0",
  "description": "Minimal terminal pomodoro timer with keyboard shortcuts and chiptune cues",
  "files": [
    "dist",
    "!dist/__tests__",
    "CHANGELOG.md",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dnim/doro-cli"
  },
  "homepage": "https://github.com/dnim/doro-cli#readme",
  "bugs": {
    "url": "https://github.com/dnim/doro-cli/issues"
  },
  "main": "dist/cli.js",
  "bin": {
    "doro": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:local": "oxlint .",
    "lint:changed": "sh scripts/lint-changed.sh",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:changed": "vitest run --changed",
    "test:visual": "npm run build && playwright test",
    "test:visual:update": "npm run build && playwright test --update-snapshots",
    "release": "npm run clean && npm run build && release-it",
    "prepare": "husky",
    "test:unit:watch": "vitest"
  },
  "keywords": [
    "pomodoro",
    "cli",
    "timer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10.5.0"
  },
  "dependencies": {
    "blessed": "npm:@rook2pawn/neo-blessed@2.0.2",
    "env-paths": "4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/blessed": "0.1.27",
    "@types/node": "25.9.9",
    "@vitest/coverage-v8": "4.1.12",
    "@yao-pkg/pkg": "6.25.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "node-pty": "1.1.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "release-it": "20.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "xterm": "5.3.0"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "npm run lint",
        "npm run format:check",
        "npm run typecheck",
        "npm run test:unit"
      ]
    }
  },
  "browserslist": [
    "maintained node versions"
  ],
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx,mts}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
